Algoritmo promedio_notas
	// Declaración de variables reales para permitir decimales
	Definir nota1, nota2, nota3 Como Real
	Definir suma Como Real
	
	// Asignación directa de valores a las notas
	nota1 <- 3
	nota2 <- 4.6
	nota3 <- 1
	
	// Cálculo e impresión del promedio
	Escribir (nota1 + nota2 + nota3) / 3
FinAlgoritmo
